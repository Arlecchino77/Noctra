@model RegisterRequest
@{
    ViewData["Title"] = "Registration";
    ViewData["Nav"] = "account";
    ViewData["NoShopHead"] = true;
    ViewData["PanelTitle"] = "THE BEST DESIGNERS OF THIS YEAR";
}

<div class="auth">
    <div class="auth__photo"><img src="~/img/registration.jpg" alt="" /></div>
    <form class="auth__form" method="post" asp-action="Register" novalidate>
        <img class="auth__logo" src="~/img/logo_text_crop.png" alt="NØCTRA" />
        <h1 class="auth__title">REGISTRATION</h1>
        <div asp-validation-summary="ModelOnly" class="field-error"></div>

        <div class="auth__row">
            <label asp-for="Name">USERNAME</label>
            <input asp-for="Name" placeholder="." autocomplete="username" />
        </div>
        <span asp-validation-for="Name" class="field-error"></span>
        <div class="auth__row">
            <label asp-for="Email">E-MAIL</label>
            <input asp-for="Email" placeholder="." autocomplete="email" />
        </div>
        <span asp-validation-for="Email" class="field-error"></span>
        <div class="auth__row">
            <label asp-for="Phone">PHONENUMBER</label>
            <input asp-for="Phone" type="tel" placeholder="." autocomplete="tel" />
        </div>
        <span asp-validation-for="Phone" class="field-error"></span>
        <div class="auth__row">
            <label asp-for="Password">PASSWORD</label>
            <input asp-for="Password" placeholder="." autocomplete="new-password" />
        </div>
        <span asp-validation-for="Password" class="field-error"></span>
        <div class="auth__row">
            <label asp-for="ConfirmPassword">REPEAT PASSWORD</label>
            <input asp-for="ConfirmPassword" placeholder="." autocomplete="new-password" />
        </div>
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>

        <div class="auth__actions">
            <button class="btn auth__btn" type="submit">CONFIRM</button>
            <span>DO YOU HAVE AN ACCOUNT?</span>
            <a class="btn auth__btn" asp-action="Login">LOGIN</a>
        </div>
    </form>
</div>

@section Panel {
    <partial name="_AuthPanel" />
}
